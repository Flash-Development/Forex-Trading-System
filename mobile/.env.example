# Copy to .env and fill in values
#
# ─── SAFE TO EXPOSE (EXPO_PUBLIC_* are bundled into the JS bundle) ────────────
# These variables are inlined by Metro at build time and visible to anyone who
# inspects the app bundle. Never put secrets here.

# Android emulator: use 10.0.2.2 (maps to host machine's localhost)
# iOS simulator:    use localhost
# Physical device:  use your machine's LAN IP e.g. http://192.168.1.x:8080
# Production:       MUST start with https://
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# One of: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Set to true to enable verbose console logging
EXPO_PUBLIC_ENABLE_LOGS=true

# ─── SECRET / SERVER-SIDE ONLY (NO EXPO_PUBLIC_ prefix) ──────────────────────
# These variables are NOT bundled into the JS bundle. They are read at build
# time via a custom Expo config plugin or injected as EAS Secrets.
# NEVER prefix these with EXPO_PUBLIC_.

# Sentry DSN — obtain from your Sentry project settings
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
